generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth.js models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App models
model Property {
  id             String          @id @default(cuid())
  street         String
  zip            String
  city           String
  totalShares    Int             @default(100)
  units          Unit[]
  billingPeriods BillingPeriod[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Unit {
  id             String              @id @default(cuid())
  propertyId     String
  name           String
  floor          String
  shares         Int
  property       Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenants        Tenant[]
  prepayments    Prepayment[]
  rentChanges    RentChange[]
  allocationKeys UnitAllocationKey[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model UnitAllocationKey {
  id         String   @id @default(cuid())
  unitId     String
  key        String
  unitValue  Float
  totalValue Float
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([unitId, key])
  @@index([key])
}

model Tenant {
  id                  String     @id @default(cuid())
  unitId              String
  salutation          String
  firstName           String
  lastName            String
  salutation2         String?
  firstName2          String?
  lastName2           String?
  phone               String?
  email               String?
  bankName            String?
  iban                String?
  accountHolder       String?
  moveInDate          DateTime
  moveOutDate         DateTime?
  leaseType           String     @default("standard") // "standard", "index", "staffel"
  indexBaseYear        Int?
  indexReferenceValue  Float?
  indexReferenceDate   DateTime?
  indexMinMonths       Int        @default(12)
  unit                Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)
  documents           Document[]
  accessToken         TenantAccessToken?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

model CostCategory {
  id              String   @id @default(cuid())
  name            String
  distributionKey String
  apportionable   Boolean  @default(true)
  sortOrder       Int      @default(0)
  costs           Cost[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BillingPeriod {
  id           String          @id @default(cuid())
  propertyId   String
  startDate    DateTime
  endDate      DateTime
  billingDate  DateTime?
  sentDate     DateTime?
  paidDate     DateTime?
  copiedFromId String?
  copiedFrom   BillingPeriod?  @relation("BillingCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       BillingPeriod[] @relation("BillingCopy")
  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  costs        Cost[]
  prepayments  Prepayment[]
  documents    Document[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Cost {
  id                      String        @id @default(cuid())
  billingPeriodId         String
  costCategoryId          String
  totalAmount             Float
  unitAmount              Float?
  reviewed                Boolean       @default(true)
  // Per-period overrides for the linked CostCategory. `enabled` hides this
  // category from this billing period without deleting it. `distributionKeyOverride`
  // replaces the category's default key for this period only (e.g. chimney
  // sweep that switches from "MEA" to "siehe Anlage" in a specific year).
  enabled                 Boolean       @default(true)
  distributionKeyOverride String?
  billingPeriod           BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  costCategory            CostCategory  @relation(fields: [costCategoryId], references: [id], onDelete: Cascade)
  createdAt               DateTime      @default(now())

  @@unique([billingPeriodId, costCategoryId])
}

model Prepayment {
  id              String        @id @default(cuid())
  billingPeriodId String
  unitId          String
  monthlyAmount   Float
  reviewed        Boolean       @default(true)
  billingPeriod   BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  unit            Unit          @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([billingPeriodId, unitId])
}

model RentChange {
  id            String   @id @default(cuid())
  unitId        String
  type          String   // "rent" or "prepayment"
  amount        Float
  effectiveDate DateTime
  reason        String?
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([unitId, effectiveDate])
}

model PdfTemplate {
  id        String   @id @default(cuid())
  name      String   @default("Standard")
  config    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VpiEntry {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  value     Float
  baseYear  Int      @default(2020)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, month, baseYear])
}

model Document {
  id              String         @id @default(cuid())
  billingPeriodId String?
  tenantId        String?
  fileName        String
  originalName    String
  mimeType        String
  size            Int
  category        String         @default("other") // "invoice", "receipt", "contract", "other"
  billingPeriod   BillingPeriod? @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  tenant          Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
}

model TenantAccessToken {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  token     String   @unique
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model LandlordInfo {
  id            String   @id @default(cuid())
  name          String
  street        String
  zip           String
  city          String
  phone         String?
  email         String?
  bankName      String?
  iban          String?
  accountHolder String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
